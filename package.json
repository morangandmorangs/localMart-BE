{
  "name": "Local-server",
  "version": "1.0.0",
  "description": "Nodejs + TS",
  "license": "ISC",
  "author": "Ilix-studio",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "start:prod": "npm run build && npm start",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "server": "nodemon src/server.ts",
    "prebuild": "prisma generate",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "cross-env DB_TARGET=local prisma migrate dev",
    "db:seed": "cross-env DB_TARGET=local prisma db seed",
    "db:studio": "cross-env DB_TARGET=local prisma studio",
    "db:deploy:local": "cross-env DB_TARGET=local prisma migrate deploy",
    "db:deploy:prod": "cross-env DB_TARGET=production prisma migrate deploy",
    "db:seed:prod": "cross-env DB_TARGET=production CONFIRM_PRODUCTION_SEED=yes prisma db seed",
    "db:studio:prod": "cross-env DB_TARGET=production prisma studio"
  },
  "dependencies": {
    "@google-cloud/recaptcha-enterprise": "^6.4.2",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csv-parse": "^1.1.12",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
